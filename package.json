{
  "name": "spacedash",
  "version": "1.3.0",
  "description": "SpaceDash: an open source site editor built on Decap CMS, added with one script tag",
  "license": "GPL-3.0",
  "author": "TalkingSites",
  "repository": "github:TalkingSites/spacedash",
  "keywords": [
    "spaceclub",
    "decap-cms",
    "cms",
    "eleventy",
    "editor"
  ],
  "type": "module",
  "files": [
    "dist",
    "server"
  ],
  "exports": {
    ".": "./dist/spacedash.js",
    "./preview": "./server/preview.cjs"
  },
  "main": "dist/spacedash.js",
  "jsdelivr": "dist/spacedash.min.js",
  "unpkg": "dist/spacedash.min.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=iife --target=es2019 --loader:.css=text --outfile=dist/spacedash.js && esbuild src/index.js --bundle --format=iife --target=es2019 --loader:.css=text --minify --outfile=dist/spacedash.min.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
